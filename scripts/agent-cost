#!/usr/bin/env python3
"""Report Claude Code spend from local session transcripts.

Claude Code already records per-message token usage, model, and skill/plugin
attribution in ~/.claude/projects/**/*.jsonl, so this reads what is on disk
instead of standing up an OpenTelemetry pipeline. That also makes it
retroactive: the history is already there.

Output is API list-price equivalent, not a bill: a subscription plan does not
charge per token. The number that matters is the relative one, which workload
costs what.

# ponytail: file-parsing, no collector. If per-request latency or live
# dashboards ever matter, CLAUDE_CODE_ENABLE_TELEMETRY=1 emits the same
# attributes over OTLP.
"""

import argparse
import collections
import datetime
import json
import pathlib
import sys

# USD per million tokens, input/output. Source: claude-api skill, cached
# 2026-06-24. Sonnet 5 carries an introductory rate through 2026-08-31; the
# standard rate is used here so the report never understates spend.
PRICES = {
    "claude-fable-5": (10.0, 50.0),
    "claude-mythos-5": (10.0, 50.0),
    "claude-opus-5": (5.0, 25.0),
    "claude-opus-4-8": (5.0, 25.0),
    "claude-opus-4-7": (5.0, 25.0),
    "claude-opus-4-6": (5.0, 25.0),
    "claude-opus-4-5": (5.0, 25.0),
    "claude-sonnet-5": (3.0, 15.0),
    "claude-sonnet-4-6": (3.0, 15.0),
    "claude-sonnet-4-5": (3.0, 15.0),
    "claude-haiku-4-5": (1.0, 5.0),
    "claude-haiku-4-5-20251001": (1.0, 5.0),
}

CACHE_READ_MULTIPLIER = 0.1
CACHE_WRITE_MULTIPLIER = {"ephemeral_5m_input_tokens": 1.25, "ephemeral_1h_input_tokens": 2.0}

DIMENSIONS = ("skill", "model", "project", "day", "plugin", "session")


def message_cost(usage, model):
    """USD for one assistant message, or None when the model is unpriced."""
    rates = PRICES.get(model)
    if rates is None:
        return None
    input_rate, output_rate = (rate / 1_000_000 for rate in rates)

    cost = usage.get("input_tokens", 0) * input_rate
    cost += usage.get("output_tokens", 0) * output_rate
    cost += usage.get("cache_read_input_tokens", 0) * input_rate * CACHE_READ_MULTIPLIER

    # Cache writes are billed by TTL, so read the breakdown when it is present
    # and fall back to the cheaper 5-minute rate when it is not.
    breakdown = usage.get("cache_creation") or {}
    if breakdown:
        for key, multiplier in CACHE_WRITE_MULTIPLIER.items():
            cost += breakdown.get(key, 0) * input_rate * multiplier
    else:
        written = usage.get("cache_creation_input_tokens", 0)
        cost += written * input_rate * CACHE_WRITE_MULTIPLIER["ephemeral_5m_input_tokens"]

    return cost


def key_for(dimension, record, path):
    if dimension == "model":
        return record["model"]
    if dimension == "skill":
        return record.get("attributionSkill") or "(no skill)"
    if dimension == "plugin":
        return record.get("attributionPlugin") or "(no plugin)"
    if dimension == "session":
        return record.get("sessionId") or path.stem
    if dimension == "day":
        return (record.get("timestamp") or "")[:10] or "(undated)"
    # project: the transcript directory encodes the cwd; the last path segment
    # is the repository or worktree name.
    cwd = record.get("cwd")
    return pathlib.Path(cwd).name if cwd else path.parent.name


def walk(root, since, until, dimensions):
    totals = {dimension: collections.Counter() for dimension in dimensions}
    tokens = {dimension: collections.Counter() for dimension in dimensions}
    unpriced = collections.Counter()
    messages = 0

    for path in root.rglob("*.jsonl"):
        try:
            lines = path.read_text(errors="ignore").splitlines()
        except OSError:
            continue
        for line in lines:
            if '"usage"' not in line:
                continue
            try:
                record = json.loads(line)
            except ValueError:
                continue
            if record.get("type") != "assistant":
                continue
            message = record.get("message") or {}
            usage = message.get("usage") or record.get("usage") or {}
            if not usage:
                continue
            stamp = record.get("timestamp") or ""
            if since and stamp < since:
                continue
            if until and stamp >= until:
                continue

            model = message.get("model") or record.get("model") or "unknown"
            record["model"] = model
            cost = message_cost(usage, model)
            if cost is None:
                unpriced[model] += 1
                continue

            billable = (
                usage.get("input_tokens", 0)
                + usage.get("output_tokens", 0)
                + usage.get("cache_read_input_tokens", 0)
                + usage.get("cache_creation_input_tokens", 0)
            )
            messages += 1
            for dimension in dimensions:
                key = key_for(dimension, record, path)
                totals[dimension][key] += cost
                tokens[dimension][key] += billable

    return totals, tokens, unpriced, messages


def report(dimension, costs, tokens, limit):
    total = sum(costs.values())
    print(f"\n## by {dimension}")
    if not costs:
        print("no data")
        return
    width = max(len(str(key)) for key, _ in costs.most_common(limit))
    for key, cost in costs.most_common(limit):
        share = 100 * cost / total if total else 0
        print(f"{str(key):<{width}}  ${cost:>9,.2f}  {share:>5.1f}%  {tokens[key]:>13,} tokens")
    remaining = len(costs) - limit
    if remaining > 0:
        print(f"... and {remaining} more")


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--days", type=int, default=30, help="only count messages from the last N days (0 for all)")
    parser.add_argument("--offset-days", type=int, default=0,
                        help="end the window N days before now, for month-over-month comparisons")
    parser.add_argument("--by", action="append", choices=DIMENSIONS,
                        help="dimension to group by; repeatable (default: skill, model, project)")
    parser.add_argument("--limit", type=int, default=15, help="rows per dimension (default: 15)")
    parser.add_argument("--transcripts", type=pathlib.Path,
                        default=pathlib.Path.home() / ".claude" / "projects",
                        help="transcript root (default: ~/.claude/projects)")
    arguments = parser.parse_args()

    dimensions = tuple(dict.fromkeys(arguments.by or ["skill", "model", "project"]))

    if not arguments.transcripts.is_dir():
        print(f"missing transcript directory: {arguments.transcripts}", file=sys.stderr)
        return 2

    # Timestamps are ISO 8601 in UTC, so string comparison is enough.
    now = datetime.datetime.now(datetime.timezone.utc)

    def stamp(days_ago):
        return (now - datetime.timedelta(days=days_ago)).isoformat().replace("+00:00", "Z")

    until = stamp(arguments.offset_days) if arguments.offset_days else ""
    since = stamp(arguments.days + arguments.offset_days) if arguments.days else ""

    totals, tokens, unpriced, messages = walk(arguments.transcripts, since, until, dimensions)

    if not arguments.days:
        window = "all time" if not arguments.offset_days else f"up to {arguments.offset_days} day(s) ago"
    elif arguments.offset_days:
        window = f"{arguments.days} day(s) ending {arguments.offset_days} day(s) ago"
    else:
        window = f"last {arguments.days} day(s)"
    grand_total = sum(totals[dimensions[0]].values()) if dimensions else 0
    print(f"# agent cost, {window}: ${grand_total:,.2f} over {messages:,} assistant message(s)")
    print("figures are API list-price equivalent; a subscription plan bills differently.")
    print("use them to compare workloads against each other, not as an invoice.")

    for dimension in dimensions:
        report(dimension, totals[dimension], tokens[dimension], arguments.limit)

    if unpriced:
        listed = ", ".join(f"{model} ({count:,})" for model, count in unpriced.most_common())
        print(f"\nunpriced models excluded: {listed}")
        print("add them to PRICES in this script once their rates are known")

    return 0


if __name__ == "__main__":
    sys.exit(main())
