#!/bin/sh
set -eu

usage() {
  cat <<'EOF'
Usage: scripts/sync-skills [--dry-run]

Remove old direct Codex and Claude skill links. Both agents load the canonical
skills through their respective plugins. Only matching links managed by this
repository are removed; existing non-matching destinations are preserved.
EOF
}

dry_run=false
case "${1:-}" in
  "")
    ;;
  --dry-run)
    dry_run=true
    ;;
  --help|-h)
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
source_dir="${ATIUM_SKILLS_SOURCE_DIR:-$repo_root/skills}"

if [ ! -d "$source_dir" ]; then
  printf 'canonical skills directory does not exist: %s\n' "$source_dir" >&2
  exit 1
fi

source_dir=$(CDPATH= cd -- "$source_dir" && pwd)
codex_dir="${ATIUM_CODEX_SKILLS_DIR:-$HOME/.codex/skills}"
claude_dir="${ATIUM_CLAUDE_SKILLS_DIR:-$HOME/.claude/skills}"
found_skill=false

remove_legacy_link() {
  source_path=$1
  destination_root=$2
  destination="$destination_root/$(basename "$source_path")"

  [ -L "$destination" ] || return 0
  if [ "$(readlink "$destination")" != "$source_path" ]; then
    return 0
  fi

  if [ "$dry_run" = true ]; then
    printf 'would unlink legacy direct skill: %s\n' "$destination"
    return 0
  fi

  rm "$destination"
  printf 'unlinked legacy direct skill: %s\n' "$destination"
}

for skill_path in "$source_dir"/*; do
  [ -d "$skill_path" ] || continue
  [ -f "$skill_path/SKILL.md" ] || {
    printf 'missing SKILL.md: %s\n' "$skill_path" >&2
    exit 1
  }
  found_skill=true
  remove_legacy_link "$skill_path" "$codex_dir"
  remove_legacy_link "$skill_path" "$claude_dir"
done

if [ "$found_skill" = false ]; then
  printf 'no canonical skills found in: %s\n' "$source_dir" >&2
  exit 1
fi
