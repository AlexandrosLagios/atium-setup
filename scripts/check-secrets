#!/bin/sh
set -eu

usage() {
  cat <<'EOF'
Usage: scripts/check-secrets

Scan the repository for committed credentials. Uses Gitleaks when installed and
falls back to a conservative pattern check otherwise.
EOF
}

case "${1:-}" in
  "")
    ;;
  --help|-h)
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --redact --no-banner "$repo_root"
  exit 0
fi

pattern='ghp_|github_pat_|AKIA[0-9A-Z]{16}|VSS_NUGET_EXTERNAL_FEED_ENDPOINTS|password[[:space:]]*=|api[_-]?key[[:space:]]*=|secret[[:space:]]*='
if git -C "$repo_root" grep -I -E "$pattern" HEAD >/dev/null 2>&1; then
  printf '%s\n' 'potential credential pattern found in current tracked files' >&2
  exit 1
fi

if git -C "$repo_root" log --all -p --format= | grep -E -i "$pattern" >/dev/null; then
  printf '%s\n' 'potential credential pattern found in Git history' >&2
  exit 1
fi

printf '%s\n' 'basic credential-pattern scan passed (install gitleaks for a full scan)'
