#!/bin/sh
set -eu

usage() {
  cat <<'EOF'
Usage: scripts/install-global-guidance [--dry-run] [--check]

Deliver the canonical global guidance to Claude Code and Codex.

The repository authors three files under global/: prose-style.md,
personal-skills-guidance.md, and claude-global-instructions.md. Two delivery
artefacts are generated from them, never edited by hand:

  AGENTS.md                        prose style plus skills guidance, for Codex
  ~/.claude/output-styles/Atium.md the same prose style, for the Claude system
                                   prompt

Claude Code reads the reply contract from the output style, so CLAUDE.md does
not import the prose rules. Set "outputStyle": "Atium" in Claude settings to
activate the style.

With --check, report whether the generated artefacts are current and exit
non-zero when they are stale. With --dry-run, report the actions and change
nothing.
EOF
}

dry_run=false
check_only=false
case "${1:-}" in
  "") ;;
  --dry-run) dry_run=true ;;
  --check) check_only=true ;;
  --help|-h) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)

source_prose="$repo_root/global/prose-style.md"
source_skills="$repo_root/global/personal-skills-guidance.md"
source_claude="$repo_root/global/claude-global-instructions.md"

for required in "$source_prose" "$source_skills" "$source_claude"; do
  [ -f "$required" ] || {
    printf 'canonical guidance does not exist: %s\n' "$required" >&2
    exit 1
  }
done

codex_home="${ATIUM_CODEX_HOME:-$HOME/.codex}"
claude_home="${ATIUM_CLAUDE_HOME:-$HOME/.claude}"
generated_agents="$repo_root/AGENTS.md"
output_style="$claude_home/output-styles/Atium.md"
banner='<!-- Generated by scripts/install-global-guidance. Edit the files under global/ instead. -->'

# Both artefacts concatenate authored files. A generated artefact never becomes
# an edit target, so each one carries the banner above.
render_agents() {
  printf '%s\n\n' "$banner"
  cat "$source_prose"
  printf '\n'
  cat "$source_skills"
}

render_output_style() {
  cat <<'EOF'
---
name: Atium
description: Status-line reply contract, state over actions, no em dash
keep-coding-instructions: true
---
EOF
  printf '\n'
  cat "$source_prose"
}

# Writing through a symlink would corrupt the authored source, so remove the
# destination before the write.
write_generated() {
  destination=$1
  renderer=$2
  if [ -e "$destination" ] || [ -L "$destination" ]; then
    if "$renderer" | cmp -s - "$destination"; then
      printf 'up to date: %s\n' "$destination"
      return 0
    fi
  fi
  if [ "$check_only" = true ]; then
    printf 'stale: %s\n' "$destination"
    return 1
  fi
  if [ "$dry_run" = true ]; then
    printf 'would generate: %s\n' "$destination"
    return 0
  fi
  mkdir -p "$(dirname "$destination")"
  rm -f "$destination"
  "$renderer" >"$destination"
  printf 'generated: %s\n' "$destination"
}

is_matching_link() {
  [ -L "$1" ] && [ "$(readlink "$1")" = "$2" ]
}

install_link() {
  destination=$1
  target=$2
  if is_matching_link "$destination" "$target"; then
    printf 'up to date: %s\n' "$destination"
    return 0
  fi
  if [ -e "$destination" ] || [ -L "$destination" ]; then
    printf 'refusing to replace existing path: %s\n' "$destination" >&2
    return 1
  fi
  if [ "$check_only" = true ]; then
    printf 'missing link: %s\n' "$destination"
    return 1
  fi
  if [ "$dry_run" = true ]; then
    printf 'would link: %s -> %s\n' "$destination" "$target"
    return 0
  fi
  mkdir -p "$(dirname "$destination")"
  ln -s "$target" "$destination"
  printf 'linked: %s -> %s\n' "$destination" "$target"
}

# AGENTS.md is committed, so only that artefact needs a staleness guard. The
# output style is deployment state, like an installed skill.
if [ "$check_only" = true ]; then
  write_generated "$generated_agents" render_agents || {
    printf 'AGENTS.md is stale; run scripts/install-global-guidance\n' >&2
    exit 1
  }
  printf '%s\n' 'generated guidance is current'
  exit 0
fi

write_generated "$generated_agents" render_agents
write_generated "$output_style" render_output_style

install_link "$codex_home/AGENTS.md" "$generated_agents"
install_link "$claude_home/CLAUDE.md" "$source_claude"
install_link "$claude_home/personal-skills-guidance.md" "$source_skills"
