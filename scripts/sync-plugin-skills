#!/bin/sh
set -eu

usage() {
  cat <<'EOF'
Usage: scripts/sync-plugin-skills [--dry-run]

Build the generated Codex plugin skill links from the canonical skills directory.
Skills listed in skills/.codexignore are excluded. The Claude plugin links the
canonical skills directory directly.
EOF
}

dry_run=false
case "${1:-}" in
  "") ;;
  --dry-run) dry_run=true ;;
  --help|-h) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
source_dir="$repo_root/skills"
plugin_skills_dir="$repo_root/plugins/atium-skills/skills"
exclude_file="$source_dir/.codexignore"

prepare_directory() {
  if [ -L "$plugin_skills_dir" ]; then
    if [ "$(readlink "$plugin_skills_dir")" != "../../skills" ]; then
      printf 'refusing to replace unexpected plugin skills link: %s\n' "$plugin_skills_dir" >&2
      exit 1
    fi
    if [ "$dry_run" = true ]; then
      printf 'would replace broad plugin skills link: %s\n' "$plugin_skills_dir"
      return 0
    fi
    rm "$plugin_skills_dir"
    mkdir "$plugin_skills_dir"
    printf 'replaced broad plugin skills link: %s\n' "$plugin_skills_dir"
    return 0
  fi

  if [ -e "$plugin_skills_dir" ]; then
    [ -d "$plugin_skills_dir" ] || {
      printf 'expected plugin skills directory: %s\n' "$plugin_skills_dir" >&2
      exit 1
    }
    return 0
  fi

  if [ "$dry_run" = true ]; then
    printf 'would create plugin skills directory: %s\n' "$plugin_skills_dir"
  else
    mkdir "$plugin_skills_dir"
    printf 'created plugin skills directory: %s\n' "$plugin_skills_dir"
  fi
}

is_excluded() {
  grep -F -x "$1" "$exclude_file" >/dev/null 2>&1
}

link_skill() {
  skill_name=$1
  destination="$plugin_skills_dir/$skill_name"
  target="../../../skills/$skill_name"

  if [ -L "$destination" ]; then
    if [ "$(readlink "$destination")" = "$target" ]; then
      printf 'up to date: %s\n' "$destination"
      return 0
    fi
    printf 'refusing to replace unexpected plugin skill link: %s\n' "$destination" >&2
    exit 1
  fi
  if [ -e "$destination" ]; then
    printf 'refusing to replace existing plugin skill path: %s\n' "$destination" >&2
    exit 1
  fi
  if [ "$dry_run" = true ]; then
    printf 'would link: %s -> %s\n' "$destination" "$target"
  else
    ln -s "$target" "$destination"
    printf 'linked: %s -> %s\n' "$destination" "$target"
  fi
}

remove_stale_link() {
  destination=$1
  skill_name=$(basename "$destination")
  expected="../../../skills/$skill_name"
  [ -L "$destination" ] || return 0
  [ "$(readlink "$destination")" = "$expected" ] || return 0
  [ -d "$source_dir/$skill_name" ] && ! is_excluded "$skill_name" && return 0

  if [ "$dry_run" = true ]; then
    printf 'would unlink stale plugin skill: %s\n' "$destination"
  else
    rm "$destination"
    printf 'unlinked stale plugin skill: %s\n' "$destination"
  fi
}

prepare_directory
[ "$dry_run" = false ] || exit 0

for skill_path in "$source_dir"/*; do
  [ -d "$skill_path" ] || continue
  skill_name=$(basename "$skill_path")
  [ -f "$skill_path/SKILL.md" ] || {
    printf 'missing SKILL.md: %s\n' "$skill_path" >&2
    exit 1
  }
  is_excluded "$skill_name" || link_skill "$skill_name"
done

for destination in "$plugin_skills_dir"/*; do
  [ -e "$destination" ] || [ -L "$destination" ] || continue
  remove_stale_link "$destination"
done
